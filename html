// ========== SAYFA 2: POPULER (GELİŞMİŞ) ==========
let popOyunlar = [];
let popYuklendi = false;
let aktifGenre = 'hepsi';
let aktifPopCat = 'all';
let popViewMode = 'list';

async function yuklePopuler(){
  if(popYuklendi) return;
  document.getElementById('pop-loader').style.display='flex';
  try{
    // 4 farklı kaynaktan veri çek
    const [topRating, topReviews, topSavings, topMixed] = await Promise.all([
      fetch('https://www.cheapshark.com/api/1.0/deals?storeID=1&sortBy=DealRating&desc=true&pageSize=40&lowerPrice=1').then(r=>r.json()),
      fetch('https://www.cheapshark.com/api/1.0/deals?storeID=1&sortBy=Reviews&desc=true&pageSize=40&lowerPrice=1').then(r=>r.json()),
      fetch('https://www.cheapshark.com/api/1.0/deals?storeID=1&sortBy=savings&desc=true&pageSize=30&lowerPrice=2').then(r=>r.json()),
      fetch('https://www.cheapshark.com/api/1.0/deals?storeID=1&sortBy=Price&desc=true&pageSize=30&lowerPrice=5').then(r=>r.json())
    ]);
    
    // Birleştir - steamAppID'ye göre benzersiz yap
    const birlesik = {};
    const kaynakEtiket = {};
    [...topRating, ...topReviews, ...topSavings, ...topMixed].forEach(o=>{
      if(!o.steamAppID) return;
      if(!birlesik[o.steamAppID] || parseFloat(o.dealRating||0)>parseFloat(birlesik[o.steamAppID].dealRating||0)){
        birlesik[o.steamAppID]=o;
        // Kaynak etiketi
        if(topRating.includes(o)) kaynakEtiket[o.steamAppID]='rating';
        else if(topReviews.includes(o)) kaynakEtiket[o.steamAppID]='reviews';
        else if(topSavings.includes(o)) kaynakEtiket[o.steamAppID]='savings';
        else kaynakEtiket[o.steamAppID]='mixed';
      }
    });
    
    popOyunlar = Object.values(birlesik)
      .filter(o=>parseFloat(o.normalPrice||0)>=3)
      .sort((a,b)=>parseFloat(b.dealRating||0)-parseFloat(a.dealRating||0))
      .slice(0,60);
    
    // Kaynak etiketini oyuna ekle
    popOyunlar.forEach(o=>{ o._kaynak = kaynakEtiket[o.steamAppID]||'mixed'; });
    
    popYuklendi = true;
    document.getElementById('pop-loader').style.display='none';
    renderPop();
    updatePopStats();
  }catch(err){
    document.getElementById('pop-loader').innerHTML=`<span style="color:var(--accent2)">⚠️ ${err.message}</span><button class="ctrl-btn" onclick="popYuklendi=false;yuklePopuler()" style="margin-top:10px">↻ Tekrar Dene</button>`;
  }
}

function updatePopStats(){
  const ind = popOyunlar.filter(o=>parseFloat(o.savings||0)>0);
  const ucr = popOyunlar.filter(o=>parseFloat(o.salePrice||0)===0);
  const enInd = popOyunlar.reduce((m,o)=>Math.max(m,parseFloat(o.savings||0)),0);
  const ortF = ind.length ? ind.reduce((s,o)=>s+parseFloat(o.salePrice),0)/ind.length : 0;
  const ortP = popOyunlar.reduce((s,o)=>s+parseFloat(o.dealRating||0),0)/popOyunlar.length;
  document.getElementById('ps-toplam').textContent = popOyunlar.length;
  document.getElementById('ps-toplam2').textContent = popOyunlar.length;
  document.getElementById('ps-indirimli').textContent = ind.length;
  document.getElementById('ps-indirimli2').textContent = ind.length;
  document.getElementById('ps-en-indirim').textContent = '%'+Math.round(enInd);
  document.getElementById('ps-en-indirim2').textContent = '%'+Math.round(enInd);
  document.getElementById('ps-ort-fiyat').textContent = '$'+ortF.toFixed(2);
  document.getElementById('ps-ort-puan').textContent = ortP.toFixed(1);
  document.getElementById('ps-ucretsiz').textContent = ucr.length;
}

function popFiltrele(){
  if(!popYuklendi) return [];
  const q = document.getElementById('pop-ara').value.toLowerCase().trim();
  const sortBy = document.getElementById('pop-sirala').value;
  let liste = [...popOyunlar];

  // Kategori filtresi
  if(aktifPopCat==='rating') liste = liste.filter(o=>parseFloat(o.dealRating||0)>=8);
  else if(aktifPopCat==='savings') liste = liste.filter(o=>parseFloat(o.savings||0)>=40);
  else if(aktifPopCat==='reviews') liste = liste.sort((a,b)=>parseFloat(b.steamRatingPercent||0)-parseFloat(a.steamRatingPercent||0));
  else if(aktifPopCat==='ucr') liste = liste.filter(o=>parseFloat(o.salePrice||0)===0);

  // Genre filtresi
  if(aktifGenre!=='hepsi') liste = liste.filter(o=>(o.title||'').toLowerCase().includes(aktifGenre));

  // Arama
  if(q) liste = liste.filter(o=>(o.title||'').toLowerCase().includes(q));

  // Sıralama
  liste.sort((a,b)=>{
    if(sortBy==='indirim') return parseFloat(b.savings||0)-parseFloat(a.savings||0);
    if(sortBy==='fiyat-asc') return parseFloat(a.salePrice||0)-parseFloat(b.salePrice||0);
    if(sortBy==='fiyat-desc') return parseFloat(b.salePrice||0)-parseFloat(a.salePrice||0);
    if(sortBy==='isim') return (a.title||'').localeCompare(b.title||'','tr');
    return parseFloat(b.dealRating||0)-parseFloat(a.dealRating||0);
  });

  return liste;
}

function renderPop(){
  if(!popYuklendi) return;
  const liste = popFiltrele();
  const featured = liste.slice(0,2);
  const rest = liste.slice(2);

  // FEATURED CARDS
  if(featured.length>0){
    document.getElementById('pop-featured').innerHTML = featured.map((o,i)=>{
      const img = `https://cdn.akamai.steamstatic.com/steam/apps/${o.steamAppID}/header.jpg`;
      const url = `https://store.steampowered.com/app/${o.steamAppID}`;
      const indirim = Math.round(parseFloat(o.savings||0));
      const ucret = parseFloat(o.salePrice)===0;
      const fav = isFav(o.steamAppID);
      const rankLabel = i===0?'🥇 En Popüler':'🥈 İkinci';
      const puan = o.dealRating ? parseFloat(o.dealRating).toFixed(1) : '—';
      return `
      <div class="feat-card" onclick="window.open('${url}','_blank')">
        <img class="feat-card-img" src="${img}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22460%22 height=%22215%22 fill=%22%23101830%22><rect width=%22460%22 height=%22215%22/><text x=%22230%22 y=%22115%22 text-anchor=%22middle%22 fill=%22%23243050%22 font-size=%2214%22>No Image</text></svg>'" loading="lazy">
        <div class="feat-overlay"><div class="feat-overlay-inner">
          <div class="feat-rank">${rankLabel} <span class="trend">⭐ ${puan}</span></div>
          <div class="feat-title">${o.title}</div>
          <div class="feat-price-row">
            ${ucret?`<span class="feat-price" style="color:var(--green)">ÜCRETSİZ</span><span class="feat-orig">$${parseFloat(o.normalPrice).toFixed(2)}</span>`
              :`<span class="feat-price">$${parseFloat(o.salePrice).toFixed(2)}</span><span class="feat-orig">$${parseFloat(o.normalPrice).toFixed(2)}</span>`}
            ${indirim>0?`<span class="feat-discount">−${indirim}%</span>`:''}
            <span class="feat-badge purple">#${i+1}</span>
          </div>
        </div></div>
        <div class="feat-fav ${fav?'active':''}" data-id="${o.steamAppID}" onclick="toggleFav('${o.steamAppID}','${(o.title||'').replace(/'/g,"\\'")}',event)">${fav?'⭐':'☆'}</div>
      </div>`;
    }).join('');
    document.getElementById('pop-featured').style.display = 'grid';
  } else {
    document.getElementById('pop-featured').style.display = 'none';
  }

  // CONTENT (list or grid)
  if(rest.length===0 && featured.length===0){
    document.getElementById('pop-content').innerHTML = `<div class="empty" style="padding:30px">🔍 Aradığın kriterlerde oyun bulunamadı</div>`;
    return;
  }

  if(popViewMode==='list'){
    document.getElementById('pop-content').innerHTML = `
    <div class="rank-list">
      ${rest.map((o,i)=>{
        const realRank = i+3;
        const img = `https://cdn.akamai.steamstatic.com/steam/apps/${o.steamAppID}/header.jpg`;
        const url = `https://store.steampowered.com/app/${o.steamAppID}`;
        const indirim = Math.round(parseFloat(o.savings||0));
        const ucret = parseFloat(o.salePrice)===0;
        const fav = isFav(o.steamAppID);
        const numClass = realRank===1?'gold':realRank===2?'silver':realRank===3?'bronze':'';
        const puan = o.dealRating ? parseFloat(o.dealRating).toFixed(1) : '—';
        const isHot = indirim>=60;
        return `
        <div class="rank-item ${isHot?'rank-item-hot':''}" onclick="window.open('${url}','_blank')">
          <span class="rank-num ${numClass}">${realRank}</span>
          <img class="rank-img" src="${img}" onerror="this.style.display='none'" loading="lazy">
          <div class="rank-info">
            <div class="rank-title">${o.title}</div>
            <div class="rank-sub">
              ⭐ ${puan}
              ${indirim>0?`<span class="badge badge-red">−${indirim}%</span>`:''}
              ${ucret?`<span class="badge badge-green">Ücretsiz</span>`:''}
              ${isHot?`<span class="rank-hot">🔥 Fırsat</span>`:''}
            </div>
          </div>
          <div class="rank-right">
            <div class="rank-price">${ucret?'ÜCRETSİZ':'$'+parseFloat(o.salePrice).toFixed(2)}</div>
            <div class="rank-orig">$${parseFloat(o.normalPrice).toFixed(2)}</div>
          </div>
          <button class="rank-fav" data-id="${o.steamAppID}" onclick="toggleFav('${o.steamAppID}','${(o.title||'').replace(/'/g,"\\'")}',event)">${fav?'⭐':'☆'}</button>
        </div>`;
      }).join('')}
    </div>`;
  } else {
    // Grid view
    document.getElementById('pop-content').innerHTML = `
    <div class="pop-grid-view">
      ${rest.map((o,i)=>{
        const realRank = i+3;
        const img = `https://cdn.akamai.steamstatic.com/steam/apps/${o.steamAppID}/header.jpg`;
        const url = `https://store.steampowered.com/app/${o.steamAppID}`;
        const indirim = Math.round(parseFloat(o.savings||0));
        const ucret = parseFloat(o.salePrice)===0;
        return `
        <div class="pop-grid-card" style="position:relative;animation-delay:${Math.min(i*0.03,0.6)}s" onclick="window.open('${url}','_blank')">
          <span class="pop-grid-rank">${realRank}</span>
          <img src="${img}" onerror="this.style.display='none'" loading="lazy">
          <div class="pop-grid-info">
            <div class="pop-grid-title">${o.title}</div>
            <div class="pop-grid-price">
              ${ucret
                ? `<span class="gp" style="font-size:11px">ÜCRETSİZ</span><span class="go">$${parseFloat(o.normalPrice).toFixed(2)}</span>`
                : `<span class="gp">$${parseFloat(o.salePrice).toFixed(2)}</span><span class="go">$${parseFloat(o.normalPrice).toFixed(2)}</span>`
              }
              ${indirim>0?`<span class="gd">−${indirim}%</span>`:''}
            </div>
          </div>
        </div>`;
      }).join('')}
    </div>`;
  }
}

function popViewDegis(mod){
  popViewMode = mod;
  document.querySelectorAll('.pop-view-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===mod));
  renderPop();
}

// Category tabs
document.querySelectorAll('.pop-cat').forEach(btn=>{
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.pop-cat').forEach(b=>b.classList.remove('active'));
    btn.classList.add('active');
    aktifPopCat = btn.dataset.popcat;
    renderPop();
  });
});

// Pop search & sort
document.getElementById('pop-ara').addEventListener('input',renderPop);
