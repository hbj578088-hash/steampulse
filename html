<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SteamPulse · Akıllı Steam Fırsat Takibi</title>
<meta name="description" content="SteamPulse; Steam indirimleri, popüler oyunlar ve ücretsiz olan oyunları tek ekranda takip eden modern fırsat paneli.">
<meta name="theme-color" content="#03050B">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#03050b;--bg2:#080c18;--surface:#0c1225;--surface2:#101830;--surface3:#0a0f20;
  --border:#162044;--border2:#1e2d55;
  --accent:#00d4ff;--accent2:#ff4f6d;--accent3:#7c3aed;
  --green:#22c55e;--gold:#f59e0b;--purple:#a78bfa;--pink:#ec4899;--orange:#f97316;
  --text:#e8edf5;--muted:#5b6f99;--muted2:#8ba0c4;
  --radius:14px;--radius-sm:8px;
}
*{scrollbar-width:thin;scrollbar-color:var(--border) transparent}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:var(--border2);border-radius:4px}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background-image:linear-gradient(rgba(0,212,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,.015) 1px,transparent 1px);background-size:48px 48px;pointer-events:none;z-index:0}
body::after{content:'';position:fixed;top:-40%;left:-20%;width:80%;height:80%;background:radial-gradient(ellipse,rgba(124,58,237,.04),transparent 70%);pointer-events:none;z-index:0;animation:ambient 12s ease-in-out infinite alternate}
@keyframes ambient{0%{transform:translate(0,0) scale(1)}100%{transform:translate(15%,10%) scale(1.2)}}

/* NAV */
nav{position:sticky;top:0;z-index:300;background:rgba(3,5,11,.92);backdrop-filter:blur(24px) saturate(1.4);-webkit-backdrop-filter:blur(24px) saturate(1.4);border-bottom:1px solid var(--border)}
.nav-inner{max-width:1440px;margin:0 auto;display:flex;align-items:center;padding:0 16px;gap:4px}
.nav-brand{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;letter-spacing:-.5px;padding:12px 16px 12px 0;border-right:1px solid var(--border);margin-right:4px;white-space:nowrap;display:flex;align-items:center;gap:6px}
.nav-brand-icon{width:22px;height:22px;background:linear-gradient(135deg,var(--accent),var(--accent3));border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff}
.nav-tabs{display:flex;overflow-x:auto;scrollbar-width:none;flex:1}
.nav-tabs::-webkit-scrollbar{display:none}
.nav-tab{padding:12px 14px;font-size:12px;font-weight:500;color:var(--muted);cursor:pointer;border:none;background:none;font-family:'DM Sans',sans-serif;transition:all .2s;position:relative;white-space:nowrap;display:flex;align-items:center;gap:5px}
.nav-tab::after{content:'';position:absolute;bottom:0;left:14px;right:14px;height:2px;background:linear-gradient(90deg,var(--accent),var(--accent3));border-radius:2px 2px 0 0;opacity:0;transition:opacity .25s}
.nav-tab.active{color:var(--text)}
.nav-tab.active::after{opacity:1}
.nav-tab:hover{color:var(--muted2)}
.nav-tab-badge{background:var(--accent2);color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:10px;line-height:1.5}
.nav-tab-badge.green{background:var(--green);color:#000}
.nav-right{margin-left:auto;display:flex;align-items:center;gap:8px;padding-left:12px}
.live-badge{display:flex;align-items:center;gap:4px;font-size:10px;color:var(--green);background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);padding:3px 8px;border-radius:20px}
.live-dot{width:5px;height:5px;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.3;transform:scale(1.8)}}

/* PAGES */
.page{display:none;position:relative;z-index:10}.page.active{display:block;animation:fadePage .35s ease}
@keyframes fadePage{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
.page-wrap{max-width:1440px;margin:0 auto;padding:0 16px}

/* ALERT BANNER */
.alert-banner{display:none;background:linear-gradient(135deg,rgba(34,197,94,.12),rgba(245,158,11,.08));border:1px solid rgba(34,197,94,.25);border-radius:10px;padding:10px 14px;margin:12px 0;align-items:center;gap:10px;animation:slideDown .4s ease}
.alert-banner.show{display:flex}
@keyframes slideDown{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}
.alert-icon{width:32px;height:32px;border-radius:8px;background:rgba(34,197,94,.15);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
.alert-text{flex:1;font-size:13px;line-height:1.4}
.alert-text strong{color:var(--green)}
.alert-close{background:none;border:none;color:var(--muted);cursor:pointer;font-size:18px;padding:4px;line-height:1;transition:color .2s}
.alert-close:hover{color:var(--text)}

/* HERO */
.hero{position:relative;text-align:center;padding:40px 16px 32px;border-bottom:1px solid var(--border);overflow:hidden}
.hero::before{content:'';position:absolute;top:-50px;left:50%;transform:translateX(-50%);width:500px;height:250px;background:radial-gradient(ellipse,rgba(0,212,255,.1),transparent 70%);pointer-events:none}
.hero h1{font-family:'Syne',sans-serif;font-size:clamp(24px,4.5vw,56px);font-weight:800;letter-spacing:-2px;background:linear-gradient(135deg,#fff 0%,var(--accent) 50%,var(--accent3) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:6px}
.hero-sub{font-size:12px;color:var(--muted)}
.hero-sub .live-dot{display:inline-block;vertical-align:middle;margin-right:4px}

/* STATS BAR */
.stats-bar{display:flex;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.stats-bar::-webkit-scrollbar{display:none}
.stat{flex:1;min-width:80px;padding:12px 12px;text-align:center;border-right:1px solid var(--border);transition:background .2s}
.stat:last-child{border-right:none}
.stat:hover{background:rgba(255,255,255,.02)}
.stat-value{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;transition:all .3s}
.stat-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:2px}

/* CONTROLS */
.controls-wrap{position:sticky;top:45px;z-index:200;background:rgba(3,5,11,.92);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--border)}
.controls-row{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:10px 16px;max-width:1440px;margin:0 auto}
.search-wrap{position:relative;flex:1;min-width:160px}
.search-wrap svg,.search-clear{position:absolute;top:50%;transform:translateY(-50%)}
.search-wrap svg{left:9px;width:13px;height:13px;stroke:var(--muted);fill:none;pointer-events:none}
.search-clear{right:8px;background:none;border:none;color:var(--muted);cursor:pointer;font-size:14px;display:none;padding:2px;line-height:1}
.search-clear.show{display:block}
#ara{width:100%;padding:7px 28px 7px 30px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;color:var(--text);font-size:12px;font-family:'DM Sans',sans-serif;outline:none;transition:border .18s,box-shadow .18s}
#ara:focus{border-color:var(--accent);box-shadow:0 0 0 2px rgba(0,212,255,.1)}
#ara::placeholder{color:var(--muted)}
.btn-group{display:flex;gap:4px;flex-wrap:wrap}
.ctrl-btn{padding:6px 11px;border-radius:6px;font-size:11px;font-weight:500;border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer;transition:all .18s;white-space:nowrap;font-family:'DM Sans',sans-serif}
.ctrl-btn:hover{border-color:var(--accent);color:var(--accent)}
.ctrl-btn.active{background:linear-gradient(135deg,var(--accent),var(--accent3));color:#fff;border-color:transparent;font-weight:600}
.ctrl-btn.fav-on{color:var(--gold);border-color:var(--gold);background:rgba(245,158,11,.1)}
select{padding:6px 9px;border-radius:6px;font-size:11px;border:1px solid var(--border);background:var(--surface2);color:var(--text);cursor:pointer;outline:none;font-family:'DM Sans',sans-serif}
select:focus{border-color:var(--accent)}
.price-sl{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--muted)}
.price-sl input[type=range]{width:72px;cursor:pointer;accent-color:var(--accent);height:3px}
.price-sl span{color:var(--text);font-weight:500;min-width:30px;font-size:10px}

/* REFRESH BAR */
.refresh-bar{padding:4px 16px;font-size:10px;color:var(--muted);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:6px}
.refresh-progress{flex:1;height:2px;background:var(--border);border-radius:2px;overflow:hidden}
.refresh-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent3),var(--pink));border-radius:2px;width:100%;transition:width 1s linear}

/* GRID & CARDS */
.section{position:relative;z-index:10;padding:20px 0 12px}
.section-header{display:flex;align-items:center;gap:8px;margin-bottom:14px;font-family:'Syne',sans-serif;font-size:16px;font-weight:700}
.sec-count{color:var(--muted);font-size:11px;font-weight:400;font-family:'DM Sans',sans-serif}
.badge{padding:2px 6px;border-radius:4px;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.6px}
.badge-red{background:rgba(255,79,109,.12);color:var(--accent2);border:1px solid rgba(255,79,109,.25)}
.badge-green{background:rgba(34,197,94,.12);color:var(--green);border:1px solid rgba(34,197,94,.25)}
.badge-blue{background:rgba(0,212,255,.12);color:var(--accent);border:1px solid rgba(0,212,255,.25)}
.badge-gold{background:rgba(245,158,11,.12);color:var(--gold);border:1px solid rgba(245,158,11,.25)}
.badge-purple{background:rgba(124,58,237,.12);color:var(--accent3);border:1px solid rgba(124,58,237,.25)}
.badge-new{background:rgba(34,197,94,.2);color:#fff;border:1px solid var(--green);animation:pulse 2s infinite}
.badge-pink{background:rgba(236,72,153,.12);color:var(--pink);border:1px solid rgba(236,72,153,.25)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px}

.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;transition:transform .25s,border-color .25s,box-shadow .3s,background .25s;position:relative;cursor:pointer;animation:fadeUp .35s ease both}
.card.free-highlight{border-color:rgba(34,197,94,.3);background:linear-gradient(135deg,rgba(34,197,94,.04),var(--surface))}
.card.new-free{border-color:var(--green);box-shadow:0 0 16px rgba(34,197,94,.08)}
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.card:hover{transform:translateY(-3px);border-color:rgba(0,212,255,.25);box-shadow:0 16px 40px rgba(0,0,0,.5),0 0 0 1px rgba(0,212,255,.06)}
.card:hover .card-img{transform:scale(1.05)}
.card-img-wrap{position:relative;overflow:hidden;height:140px}
.card-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
.card-img-wrap::after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,transparent 30%,var(--surface));pointer-events:none}
.tag{position:absolute;top:6px;left:6px;z-index:2;font-family:'Syne',sans-serif;font-size:10px;font-weight:700;padding:2px 7px;border-radius:4px;letter-spacing:.2px;display:flex;align-items:center;gap:3px}
.tag-discount{background:var(--accent2);color:#fff}
.tag-free{background:var(--green);color:#000}
.tag-newfree{background:var(--green);color:#000;border:1px solid rgba(255,255,255,.3)}
.tag-newfree::before{content:'✨';font-size:9px}
.fav-btn{position:absolute;top:6px;right:6px;z-index:3;width:26px;height:26px;border-radius:5px;background:rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.1);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .18s;backdrop-filter:blur(6px)}
.fav-btn:hover{border-color:var(--gold);background:rgba(245,158,11,.2)}
.fav-btn.active{border-color:var(--gold);background:rgba(245,158,11,.15)}
.card-body{padding:8px 10px 10px}
.card-title{font-weight:500;font-size:12px;margin-bottom:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:var(--text);display:flex;align-items:center;gap:4px}
.price-row{display:flex;align-items:center;gap:5px;margin-bottom:5px;flex-wrap:wrap}
.price{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;color:var(--green)}
.original{font-size:10px;color:var(--muted);text-decoration:line-through}
.card-meta{display:flex;align-items:center;justify-content:space-between;gap:4px;font-size:10px}
.rating-txt{color:var(--muted);display:flex;align-items:center;gap:3px}
.go-btn{display:inline-flex;align-items:center;gap:3px;font-size:9px;font-weight:500;padding:3px 8px;border-radius:4px;background:rgba(0,212,255,.08);color:var(--accent);border:1px solid rgba(0,212,255,.15);text-decoration:none;transition:all .18s;white-space:nowrap}
.go-btn:hover{background:rgba(0,212,255,.2);border-color:rgba(0,212,255,.4)}
.card-genre{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;padding:1px 5px;border-radius:3px;background:var(--surface2);border:1px solid var(--border)}

/* SKELETON */
.loader{grid-column:1/-1;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 16px;gap:10px;color:var(--muted)}
.spin{width:30px;height:30px;border:2px solid var(--border);border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.skeleton{background:linear-gradient(90deg,var(--surface) 25%,var(--surface2) 50%,var(--surface) 75%);background-size:200% 100%;animation:shimmer 1.5s infinite;border-radius:var(--radius);border:1px solid var(--border)}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.empty{grid-column:1/-1;text-align:center;padding:40px 16px;color:var(--muted);font-size:12px;line-height:1.8}

/* MODAL */
.modal-overlay{position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);opacity:0;pointer-events:none;transition:opacity .3s}
.modal-overlay.show{opacity:1;pointer-events:all}
.modal{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.92);z-index:9999;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:0;width:92%;max-width:540px;max-height:85vh;overflow-y:auto;opacity:0;pointer-events:none;transition:all .35s cubic-bezier(.34,1.56,.64,1);box-shadow:0 40px 80px rgba(0,0,0,.7)}
.modal.show{opacity:1;pointer-events:all;transform:translate(-50%,-50%) scale(1)}
.modal-img{width:100%;height:180px;object-fit:cover;display:block;border-radius:18px 18px 0 0}
.modal-close{position:absolute;top:10px;right:10px;width:30px;height:30px;border-radius:8px;background:rgba(0,0,0,.7);border:1px solid rgba(255,255,255,.1);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:all .18s;backdrop-filter:blur(6px)}
.modal-close:hover{background:rgba(255,79,109,.3);border-color:var(--accent2)}
.modal-body{padding:16px 18px 20px}
.modal-title{font-family:'Syne',sans-serif;font-size:20px;font-weight:700;margin-bottom:8px}
.modal-price-row{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
.modal-price{font-family:'Syne',sans-serif;font-size:28px;font-weight:700;color:var(--green)}
.modal-original{font-size:14px;color:var(--muted);text-decoration:line-through}
.modal-discount{background:var(--accent2);color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px}
.modal-meta{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px}
.modal-meta-item{background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:8px 10px}
.modal-meta-label{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}
.modal-meta-val{font-size:13px;font-weight:600;margin-top:2px}
.modal-desc{font-size:12px;color:var(--muted2);line-height:1.6;margin-bottom:14px}
.modal-actions{display:flex;gap:8px}
.modal-btn{flex:1;padding:9px;border-radius:8px;border:none;cursor:pointer;font-size:12px;font-weight:600;font-family:'DM Sans',sans-serif;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:5px}
.modal-btn.primary{background:linear-gradient(135deg,var(--accent),var(--accent3));color:#fff}
.modal-btn.primary:hover{transform:translateY(-1px);box-shadow:0 4px 16px rgba(0,212,255,.25)}
.modal-btn.secondary{background:var(--surface2);color:var(--text);border:1px solid var(--border)}
.modal-btn.secondary:hover{border-color:var(--accent);color:var(--accent)}
.modal-price-history{margin-top:12px;padding:10px;background:var(--surface2);border:1px solid var(--border);border-radius:8px}
.modal-price-history h4{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;margin-bottom:6px}
.modal-ph-list{display:flex;gap:4px;flex-wrap:wrap}
.modal-ph-item{font-size:9px;padding:2px 6px;border-radius:3px;background:var(--surface3);border:1px solid var(--border);color:var(--muted2)}


/* STEAMPULSE GELİŞMİŞ OYUN PENCERESİ */
.modal{max-width:760px}
.modal-hero{position:relative;min-height:230px;background:var(--surface3);overflow:hidden;border-radius:18px 18px 0 0}
.modal-hero .modal-img{height:230px;border-radius:18px 18px 0 0;filter:saturate(1.08)}
.modal-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(to top,rgba(3,5,11,.98) 0%,rgba(3,5,11,.55) 45%,transparent 100%);pointer-events:none}
.modal-hero-title{position:absolute;left:18px;right:54px;bottom:16px;z-index:2}
.modal-title{font-size:24px;letter-spacing:-.8px;text-shadow:0 2px 16px rgba(0,0,0,.6)}
.modal-mini-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}
.modal-chip{font-size:9px;font-weight:700;padding:3px 7px;border-radius:999px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:var(--muted2);letter-spacing:.3px}
.modal-chip.green{color:var(--green);border-color:rgba(34,197,94,.25);background:rgba(34,197,94,.1)}
.modal-chip.red{color:var(--accent2);border-color:rgba(255,79,109,.25);background:rgba(255,79,109,.1)}
.modal-chip.blue{color:var(--accent);border-color:rgba(0,212,255,.25);background:rgba(0,212,255,.1)}
.modal-top-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:12px;margin-bottom:14px}
.modal-price-box{background:linear-gradient(135deg,rgba(34,197,94,.08),rgba(0,212,255,.04));border:1px solid rgba(34,197,94,.18);border-radius:12px;padding:12px}
.modal-price-main{display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap}
.modal-price-tl{font-family:'Syne',sans-serif;font-size:22px;font-weight:800;color:var(--accent);margin-top:4px}
.modal-rate-note{font-size:9px;color:var(--muted);margin-top:5px}
.modal-score-box{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.modal-score{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:10px;text-align:center}
.modal-score strong{display:block;font-family:'Syne',sans-serif;font-size:20px;color:var(--text)}
.modal-score span{font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px}
.modal-detail-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:12px 0}
.modal-detail-item{background:var(--surface2);border:1px solid var(--border);border-radius:10px;padding:9px 10px;min-width:0}
.modal-detail-label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.7px;margin-bottom:2px}
.modal-detail-val{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.modal-desc{background:var(--surface2);border:1px solid var(--border);border-radius:12px;padding:12px;margin:12px 0;color:var(--muted2)}
.modal-desc-title{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px;font-weight:700}
.modal-actions{display:grid;grid-template-columns:1.3fr 1.3fr 1fr 1fr;gap:8px}
.modal-btn.danger{background:rgba(255,79,109,.09);color:var(--accent2);border:1px solid rgba(255,79,109,.22)}
.modal-btn.green{background:linear-gradient(135deg,var(--green),#16a34a);color:#001506}
.modal-loading{padding:24px;text-align:center;color:var(--muted);font-size:12px}
.alert-mini{margin-top:10px;display:flex;gap:6px;align-items:center;background:rgba(0,212,255,.06);border:1px solid rgba(0,212,255,.15);border-radius:10px;padding:9px 10px;font-size:11px;color:var(--muted2)}
@media(max-width:700px){.modal-top-grid{grid-template-columns:1fr}.modal-detail-grid{grid-template-columns:1fr 1fr}.modal-actions{grid-template-columns:1fr 1fr}.modal-hero .modal-img{height:190px}.modal-title{font-size:20px}}
@media(max-width:430px){.modal-detail-grid{grid-template-columns:1fr}.modal-actions{grid-template-columns:1fr}.modal-score-box{grid-template-columns:1fr 1fr}}

/* TOAST */
.toast{position:fixed;bottom:16px;right:16px;z-index:9999;background:var(--surface2);border:1px solid var(--border2);border-radius:10px;padding:9px 12px;font-size:12px;color:var(--text);transform:translateY(80px);opacity:0;transition:all .3s cubic-bezier(.34,1.56,.64,1);pointer-events:none;display:flex;align-items:center;gap:6px;box-shadow:0 8px 32px rgba(0,0,0,.5);max-width:340px}
.toast.show{transform:translateY(0);opacity:1}
.section-divider{height:1px;background:linear-gradient(90deg,transparent,var(--border),transparent);margin:4px 0}

/* ===== POPÜLER (YENİ) ===== */
.pop-hero{position:relative;padding:36px 16px 28px;border-bottom:1px solid var(--border);text-align:center;overflow:hidden}
.pop-hero::before{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:700px;height:400px;background:radial-gradient(ellipse,rgba(167,139,250,.1),transparent 70%);pointer-events:none}
.pop-hero::after{content:'';position:absolute;bottom:-20px;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(167,139,250,.3),transparent)}
.pop-hero h1{font-family:'Syne',sans-serif;font-size:clamp(22px,4vw,48px);font-weight:800;letter-spacing:-2px;background:linear-gradient(135deg,#fff 0%,var(--purple) 40%,var(--gold) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:6px}
.pop-hero p{font-size:12px;color:var(--muted)}
.pop-hero .hero-counts{display:flex;justify-content:center;gap:16px;margin-top:8px;font-size:10px;color:var(--muted2)}
.pop-hero .hero-counts span{display:flex;align-items:center;gap:4px}

/* Category Tabs */
.pop-cats{display:flex;gap:4px;padding:12px 0;border-bottom:1px solid var(--border);overflow-x:auto;scrollbar-width:none}
.pop-cats::-webkit-scrollbar{display:none}
.pop-cat{padding:7px 16px;border-radius:20px;font-size:11px;font-weight:500;border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer;transition:all .2s;white-space:nowrap;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:4px}
.pop-cat:hover{border-color:var(--purple);color:var(--purple)}
.pop-cat.active{background:linear-gradient(135deg,var(--purple),var(--accent3));color:#fff;border-color:transparent}

/* Stats Dashboard */
.pop-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:6px;margin:14px 0}
.pop-stat{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:10px 8px;text-align:center;transition:border-color .2s}
.pop-stat:hover{border-color:rgba(167,139,250,.3)}
.pop-stat-val{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;transition:all .3s}
.pop-stat-label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin-top:2px}

/* Controls row for pop page */
.pop-controls{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:10px 0;border-bottom:1px solid var(--border)}
.pop-search{position:relative;flex:1;min-width:140px}
.pop-search svg{position:absolute;left:9px;top:50%;transform:translateY(-50%);width:12px;height:12px;stroke:var(--muted);fill:none;pointer-events:none}
.pop-search input{width:100%;padding:6px 9px 6px 28px;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:11px;font-family:'DM Sans',sans-serif;outline:none;transition:border .18s}
.pop-search input:focus{border-color:var(--purple)}
.pop-search input::placeholder{color:var(--muted)}
.pop-view-btn{padding:5px 9px;border-radius:5px;font-size:11px;border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer;transition:all .18s;font-family:'DM Sans',sans-serif;display:flex;align-items:center;gap:3px}
.pop-view-btn.active{background:var(--purple);color:#fff;border-color:transparent}
.pop-view-btn:hover:not(.active){border-color:var(--purple);color:var(--purple)}
.pop-sort{padding:5px 8px;border-radius:5px;font-size:11px;border:1px solid var(--border);background:var(--surface2);color:var(--text);cursor:pointer;outline:none;font-family:'DM Sans',sans-serif}
.pop-sort:focus{border-color:var(--purple)}

/* Featured Grid */
.featured-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
@media(max-width:700px){.featured-grid{grid-template-columns:1fr}}
.feat-card{background:var(--surface);border:1px solid var(--border);border-radius:16px;overflow:hidden;position:relative;cursor:pointer;transition:all .3s;min-height:190px}
.feat-card:hover{transform:translateY(-3px);border-color:rgba(167,139,250,.35);box-shadow:0 16px 44px rgba(0,0,0,.5)}
.feat-card-img{width:100%;height:190px;object-fit:cover;display:block;transition:transform .5s}
.feat-card:hover .feat-card-img{transform:scale(1.05)}
.feat-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(3,5,11,.96) 25%,transparent 75%);padding:14px}
.feat-overlay-inner{position:absolute;bottom:12px;left:14px;right:14px}
.feat-rank{font-family:'Syne',sans-serif;font-size:9px;font-weight:700;color:var(--gold);letter-spacing:2px;text-transform:uppercase;margin-bottom:3px;display:flex;align-items:center;gap:4px}
.feat-rank .trend{color:var(--green);font-size:8px;background:rgba(34,197,94,.12);padding:1px 5px;border-radius:3px}
.feat-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;margin-bottom:3px;color:#fff;text-shadow:0 1px 4px rgba(0,0,0,.5)}
.feat-price-row{display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.feat-price{font-family:'Syne',sans-serif;font-size:17px;font-weight:700;color:var(--green)}
.feat-orig{font-size:10px;color:var(--muted);text-decoration:line-through}
.feat-discount{background:var(--accent2);color:#fff;font-size:8px;font-weight:700;padding:2px 6px;border-radius:3px;font-family:'Syne',sans-serif}
.feat-badge{font-size:7px;font-weight:700;padding:2px 5px;border-radius:3px;text-transform:uppercase;letter-spacing:.5px}
.feat-badge.purple{background:rgba(167,139,250,.2);color:var(--purple);border:1px solid rgba(167,139,250,.3)}
.feat-badge.green{background:rgba(34,197,94,.2);color:var(--green);border:1px solid rgba(34,197,94,.3)}
.feat-fav{position:absolute;top:10px;right:10px;z-index:3;width:26px;height:26px;border-radius:6px;background:rgba(0,0,0,.65);border:1px solid rgba(255,255,255,.1);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .18s;backdrop-filter:blur(6px)}
.feat-fav:hover{border-color:var(--gold);background:rgba(245,158,11,.2)}
.feat-fav.active{border-color:var(--gold);background:rgba(245,158,11,.15)}
.feat-platform{position:absolute;bottom:56px;left:14px;z-index:3;display:flex;gap:3px}
.feat-platform span{width:14px;height:14px;border-radius:3px;background:rgba(0,0,0,.55);border:1px solid rgba(255,255,255,.08);display:flex;align-items:center;justify-content:center;font-size:7px;backdrop-filter:blur(4px)}

/* Rank List */
.rank-list{display:flex;flex-direction:column;gap:5px;margin-bottom:16px}
.rank-item{display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:7px 10px;cursor:pointer;transition:all .2s;text-decoration:none;color:var(--text)}
.rank-item:hover{border-color:rgba(167,139,250,.3);background:rgba(12,18,37,.95);transform:translateX(3px)}
.rank-item.rank-item-hot{border-left:2px solid var(--orange)}
.rank-num{font-family:'Syne',sans-serif;font-size:15px;font-weight:800;color:var(--border2);min-width:22px;text-align:center;line-height:1}
.rank-num.gold{color:var(--gold)}
.rank-num.silver{color:var(--muted2)}
.rank-num.bronze{color:#cd7f32}
.rank-img{width:60px;height:34px;object-fit:cover;border-radius:4px;flex-shrink:0}
.rank-info{flex:1;min-width:0}
.rank-title{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:1px}
.rank-sub{font-size:9px;color:var(--muted);display:flex;align-items:center;gap:3px;flex-wrap:wrap}
.rank-right{text-align:right;flex-shrink:0}
.rank-price{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--green)}
.rank-orig{font-size:8px;color:var(--muted);text-decoration:line-through}
.rank-fav{background:none;border:none;font-size:13px;cursor:pointer;padding:2px;transition:transform .18s}
.rank-fav:hover{transform:scale(1.3)}
.rank-hot{font-size:7px;font-weight:700;color:var(--orange);background:rgba(249,115,22,.1);padding:1px 5px;border-radius:3px;border:1px solid rgba(249,115,22,.2);text-transform:uppercase;letter-spacing:.5px}

/* Genre Tabs */
.genre-tabs{display:flex;gap:4px;flex-wrap:wrap;padding:10px 0;border-bottom:1px solid var(--border);margin-bottom:12px}
.genre-btn{padding:4px 10px;border-radius:14px;font-size:10px;font-weight:500;border:1px solid var(--border);background:var(--surface2);color:var(--muted);cursor:pointer;transition:all .18s;font-family:'DM Sans',sans-serif}
.genre-btn.active{background:linear-gradient(135deg,var(--purple),var(--accent3));color:#fff;border-color:transparent}
.genre-btn:hover:not(.active){border-color:var(--purple);color:var(--purple)}
.genre-btn .gcount{font-size:8px;opacity:.6;margin-left:2px}

/* Grid view for pop */
.pop-grid-view{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:8px;margin-bottom:16px}
.pop-grid-card{background:var(--surface);border:1px solid var(--border);border-radius:12px;overflow:hidden;cursor:pointer;transition:all .25s;animation:fadeUp .3s ease both}
.pop-grid-card:hover{transform:translateY(-3px);border-color:rgba(167,139,250,.3);box-shadow:0 12px 32px rgba(0,0,0,.4)}
.pop-grid-card img{width:100%;height:110px;object-fit:cover;display:block;transition:transform .4s}
.pop-grid-card:hover img{transform:scale(1.04)}
.pop-grid-info{padding:8px 10px}
.pop-grid-title{font-size:11px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
.pop-grid-price{display:flex;align-items:center;gap:4px}
.pop-grid-price .gp{font-family:'Syne',sans-serif;font-size:13px;font-weight:700;color:var(--green)}
.pop-grid-price .go{font-size:9px;color:var(--muted);text-decoration:line-through}
.pop-grid-price .gd{font-size:8px;font-weight:700;color:var(--accent2)}
.pop-grid-rank{position:absolute;top:6px;left:6px;z-index:2;width:22px;height:22px;border-radius:4px;background:rgba(0,0,0,.6);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;font-family:'Syne',sans-serif;color:var(--gold);backdrop-filter:blur(4px)}

.section-title{font-family:'Syne',sans-serif;font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:6px}
.section-title .st-badge{font-size:8px;font-weight:700;padding:2px 6px;border-radius:4px;background:rgba(167,139,250,.12);color:var(--purple);border:1px solid rgba(167,139,250,.2)}

/* FREE DETECT TAB */
.free-hero{position:relative;padding:36px 16px 28px;border-bottom:1px solid var(--border);text-align:center;overflow:hidden}
.free-hero::before{content:'';position:absolute;top:-60px;left:50%;transform:translateX(-50%);width:500px;height:300px;background:radial-gradient(ellipse,rgba(34,197,94,.1),transparent 70%);pointer-events:none}
.free-hero h1{font-family:'Syne',sans-serif;font-size:clamp(22px,4vw,48px);font-weight:800;letter-spacing:-2px;background:linear-gradient(135deg,#fff 0%,var(--green) 50%,var(--gold) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;line-height:1;margin-bottom:6px}
.free-hero p{font-size:12px;color:var(--muted)}
.new-free-list{display:flex;flex-direction:column;gap:8px;margin:16px 0}
.new-free-item{display:flex;align-items:center;gap:12px;background:linear-gradient(135deg,rgba(34,197,94,.06),var(--surface));border:1px solid rgba(34,197,94,.25);border-radius:12px;padding:10px 14px;transition:all .2s;cursor:pointer}
.new-free-item:hover{transform:translateX(3px);border-color:rgba(34,197,94,.4);box-shadow:0 4px 20px rgba(34,197,94,.08)}
.nf-icon{width:36px;height:36px;border-radius:8px;background:rgba(34,197,94,.12);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.nf-info{flex:1;min-width:0}
.nf-title{font-size:13px;font-weight:600;margin-bottom:2px}
.nf-meta{font-size:10px;color:var(--muted);display:flex;gap:8px;flex-wrap:wrap}
.nf-meta span{display:flex;align-items:center;gap:3px}
.nf-badge{font-size:8px;font-weight:700;padding:2px 6px;border-radius:4px;background:var(--green);color:#000;letter-spacing:.5px}
.nf-date{color:var(--muted);font-size:9px;white-space:nowrap}
.nf-action{background:rgba(34,197,94,.1);border:1px solid rgba(34,197,94,.2);color:var(--green);padding:4px 10px;border-radius:5px;font-size:10px;cursor:pointer;transition:all .18s;text-decoration:none;font-weight:500}
.nf-action:hover{background:rgba(34,197,94,.2)}

/* FOOTER */
footer{position:relative;z-index:10;text-align:center;padding:28px 16px;color:var(--muted);font-size:10px;border-top:1px solid var(--border);margin-top:36px;line-height:1.8}
footer a{color:var(--muted2);text-decoration:none}
footer a:hover{color:var(--accent)}

/* SCROLL TOP */
.scroll-top{position:fixed;bottom:16px;left:16px;z-index:400;width:34px;height:34px;border-radius:8px;background:var(--surface2);border:1px solid var(--border);color:var(--muted);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:15px;transition:all .2s;opacity:0;pointer-events:none;backdrop-filter:blur(8px)}
.scroll-top.show{opacity:1;pointer-events:all}
.scroll-top:hover{border-color:var(--accent);color:var(--accent)}

/* RANDOM PICKER */
.random-picker{position:relative;z-index:10;padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.random-picker-btn{display:flex;align-items:center;gap:5px;padding:7px 14px;border-radius:8px;border:1px solid var(--border);background:linear-gradient(135deg,rgba(0,212,255,.08),rgba(124,58,237,.08));color:var(--text);font-size:12px;font-weight:500;cursor:pointer;font-family:'DM Sans',sans-serif;transition:all .2s}
.random-picker-btn:hover{border-color:var(--accent);box-shadow:0 0 20px rgba(0,212,255,.1)}
.random-picker-btn:active{transform:scale(.96)}
.random-result{font-size:12px;color:var(--muted2);flex:1}
.random-result strong{color:var(--accent);cursor:pointer}
.random-result strong:hover{text-decoration:underline}


/* ===== STEAMPULSE PRO TOUCHES ===== */
.brand-word{font-family:'Syne',sans-serif;font-weight:800;letter-spacing:-.7px;background:linear-gradient(135deg,#fff,var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.brand-word span{background:linear-gradient(135deg,var(--accent),var(--accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.pulse-logo-mini{font-size:15px;box-shadow:0 0 18px rgba(0,212,255,.35);animation:pulseLogo 2.6s ease-in-out infinite}
@keyframes pulseLogo{0%,100%{transform:scale(1);filter:brightness(1)}50%{transform:scale(1.08);filter:brightness(1.35)}}
.hero-pro{padding:54px 16px 42px;background:radial-gradient(circle at 50% 0%,rgba(0,212,255,.09),transparent 35%),radial-gradient(circle at 20% 30%,rgba(124,58,237,.09),transparent 35%)}
.hero-pro h1{font-size:clamp(34px,7vw,82px);letter-spacing:-4px;margin-bottom:10px}
.hero-kicker{display:inline-flex;align-items:center;gap:7px;margin-bottom:12px;padding:6px 12px;border-radius:999px;background:rgba(0,212,255,.07);border:1px solid rgba(0,212,255,.18);color:var(--accent);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.9px}
.hero-desc{max-width:620px;margin:0 auto 8px;color:var(--muted2);font-size:14px;line-height:1.6}
.hero-actions{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:16px}
.hero-btn{border:1px solid var(--border2);background:rgba(16,24,48,.72);color:var(--text);padding:9px 16px;border-radius:10px;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:700;cursor:pointer;transition:all .2s;backdrop-filter:blur(10px)}
.hero-btn:hover{transform:translateY(-2px);border-color:var(--accent);box-shadow:0 12px 28px rgba(0,0,0,.35)}
.hero-btn.primary{border-color:transparent;background:linear-gradient(135deg,var(--accent),var(--accent3));color:#fff}
.feature-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding-top:12px;padding-bottom:12px;border-bottom:1px solid var(--border)}
.feature-pill{background:linear-gradient(135deg,rgba(12,18,37,.92),rgba(16,24,48,.78));border:1px solid var(--border);border-radius:12px;padding:11px 12px;min-height:64px;transition:all .2s}
.feature-pill:hover{transform:translateY(-2px);border-color:rgba(0,212,255,.28);box-shadow:0 10px 30px rgba(0,0,0,.28)}
.feature-pill strong{display:block;font-size:12px;margin-bottom:4px;color:var(--text)}
.feature-pill span{display:block;font-size:10px;color:var(--muted2);line-height:1.35}
.card,.pop-grid-card,.rank-item,.feat-card,.new-free-item{box-shadow:0 10px 30px rgba(0,0,0,.12)}
.ctrl-btn.active,.pop-cat.active,.genre-btn.active{box-shadow:0 8px 24px rgba(0,212,255,.14)}
@media(max-width:900px){.feature-strip{grid-template-columns:1fr 1fr}.hero-pro h1{letter-spacing:-2px}}
@media(max-width:520px){.feature-strip{grid-template-columns:1fr}.hero-actions{display:grid}.hero-btn{width:100%}}

/* RESPONSIVE */
@media(max-width:640px){
  .nav-inner{gap:2px}
  .nav-brand{font-size:13px;padding:10px 10px 10px 0;border-right:none}
  .nav-tab{padding:10px 10px;font-size:11px}
  .nav-tab::after{left:10px;right:10px}
  .controls-row{flex-direction:column;align-items:stretch;gap:5px}
  .stats-bar{display:grid;grid-template-columns:1fr 1fr 1fr}
  .stat{border-right:none;border-bottom:1px solid var(--border);padding:10px 8px}
  .featured-grid{grid-template-columns:1fr}
  .grid{grid-template-columns:repeat(auto-fill,minmax(160px,1fr))}
  .card-img-wrap{height:100px}
  .modal{width:96%;max-height:90vh}
  .modal-img{height:140px}
}
@media(max-width:400px){
  .grid{grid-template-columns:1fr 1fr;gap:6px}
  .card-img-wrap{height:80px}
  .card-body{padding:6px 7px 8px}
  .card-title{font-size:11px}
  .price{font-size:14px}
}

/* TOOLTIP */
[data-tooltip]{position:relative}
[data-tooltip]:hover::after{content:attr(data-tooltip);position:absolute;bottom:calc(100%+5px);left:50%;transform:translateX(-50%);background:var(--surface2);color:var(--text);font-size:10px;padding:4px 8px;border-radius:4px;border:1px solid var(--border);white-space:nowrap;z-index:100;pointer-events:none}

/* COUNTER BADGE ANIM */
@keyframes popIn{0%{transform:scale(0)}70%{transform:scale(1.15)}100%{transform:scale(1)}}
