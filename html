// Not: CheapShark bazen Steam'de kısa süreli %100 ücretsiz olan oyunları geç yakalıyor.
// Bu yüzden Steam'de görünen sıcak ücretsiz kampanyalar için ayrı bir kontrol listesi ekledik.
// Steam API tarayıcıda CORS/ülke kısıtına takılırsa aşağıdaki yedek bilgiler gösterilir.
const STEAM_PROMO_WATCHLIST = [
  { steamAppID:'6100',    title:'Eets',                         normalPrice:'5.79',  salePrice:'0.00', savings:'100', dealRating:'10.0', source:'Steam', desc:'Steam arama önerilerinde ücretsiz görünen kampanya.' },
  { steamAppID:'1053710', title:'The Red Lantern',              normalPrice:'6.92',  salePrice:'0.00', savings:'100', dealRating:'9.6',  source:'Steam', desc:'Kısa süreli %100 ücretsiz Steam kampanyası.' },
  { steamAppID:'1433340', title:"Happy's Humble Burger Farm",  normalPrice:'10.49', salePrice:'0.00', savings:'100', dealRating:'9.4',  source:'Steam', desc:'Kısa süreli %100 ücretsiz Steam kampanyası.' }
];

function steamPromoFallbackItem(x){
  return {
    title:x.title,
    steamAppID:x.steamAppID,
    salePrice:x.salePrice,
    normalPrice:x.normalPrice,
    savings:x.savings,
    dealRating:x.dealRating,
    steamRatingText:'Steam Ücretsiz Kampanya',
    steamRatingPercent:'100',
    steamRatingCount:'0',
    thumb:`https://cdn.akamai.steamstatic.com/steam/apps/${x.steamAppID}/header.jpg`,
    isSteamPromo:true,
    promoSource:x.source,
    short_description:x.desc
  };
}

async function steamPromolariYukle(){
  const sonuc = [];
  await Promise.all(STEAM_PROMO_WATCHLIST.map(async x=>{
    try{
      const r = await fetch(`https://store.steampowered.com/api/appdetails?appids=${x.steamAppID}&cc=us&l=turkish`);
      const j = await r.json();
      const d = j && j[x.steamAppID] && j[x.steamAppID].success ? j[x.steamAppID].data : null;
      if(!d){ sonuc.push(steamPromoFallbackItem(x)); return; }
      const po = d.price_overview || {};
      const finalUsd = typeof po.final === 'number' ? po.final / 100 : (d.is_free ? 0 : parseFloat(x.salePrice));
      const initialUsd = typeof po.initial === 'number' ? po.initial / 100 : parseFloat(x.normalPrice);
      // Sadece şu an ücretsizse veya yedek listede %100 kampanya olarak işaretliyse göster.
      if(finalUsd === 0 || d.is_free || parseFloat(x.salePrice) === 0){
        sonuc.push({
          title:d.name || x.title,
          steamAppID:x.steamAppID,
          salePrice:'0.00',
          normalPrice:(initialUsd || parseFloat(x.normalPrice) || 0).toFixed(2),
          savings:'100',
          dealRating:x.dealRating,
          steamRatingText:d.recommendations ? 'Steam Önerileri' : 'Steam Ücretsiz Kampanya',
          steamRatingPercent:'100',
          steamRatingCount:d.recommendations ? String(d.recommendations.total || 0) : '0',
          thumb:`https://cdn.akamai.steamstatic.com/steam/apps/${x.steamAppID}/header.jpg`,
          isSteamPromo:true,
          promoSource:'Steam AppDetails',
          short_description:d.short_description || x.desc,
          genres:(d.genres||[]).map(g=>g.description).join(', '),
          developer:(d.developers||[]).join(', '),
          publisher:(d.publishers||[]).join(', ')
        });
      }
    }catch(e){
      sonuc.push(steamPromoFallbackItem(x));
    }
  }));
  return sonuc;
}

function oyunlariBirlestir(...listeler){
  const map = new Map();
  listeler.flat().forEach(o=>{
    if(!o || !o.steamAppID) return;
    const id = String(o.steamAppID);
    const eski = map.get(id);
    // Ücretsiz Steam promosunu her zaman öncele.
    if(!eski || (parseFloat(o.salePrice||0)===0 && o.isSteamPromo) || parseFloat(o.savings||0) > parseFloat(eski.savings||0)){
      map.set(id,o);
    }
  });
  return Array.from(map.values());
}

