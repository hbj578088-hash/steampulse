function renderUcretsizSayfasi(){
  const ucretsizOyunlar = tumOyunlar.filter(o=>parseFloat(o.salePrice||0)===0);
  const yeniListe = yeniUcretsizler.filter(f=>{
    const o = tumOyunlar.find(x=>String(x.steamAppID)===String(f.id));
    return o && parseFloat(o.salePrice||0)===0;
  });

  document.getElementById('fs-toplam').textContent = ucretsizOyunlar.length;
  document.getElementById('fs-yeni').textContent = yeniListe.length;
  document.getElementById('fs-takip').textContent = Object.keys(fiyatGecmisi).length;
  document.getElementById('yeni-ucr-sayisi').textContent = yeniListe.length;
  document.getElementById('tum-ucr-sayisi').textContent = ucretsizOyunlar.length;

  // Yeni ücretsiz listesi
  if(yeniListe.length>0){
    document.getElementById('yeni-ucretsiz-list').innerHTML = yeniListe.map(f=>{
      const o = tumOyunlar.find(x=>String(x.steamAppID)===String(f.id));
      if(!o) return '';
      const img = `https://cdn.akamai.steamstatic.com/steam/apps/${f.id}/header.jpg`;
      const url = `https://store.steampowered.com/app/${f.id}`;
      const tarih = new Date(f.kesifTarihi);
      const tarihStr = `${tarih.toLocaleDateString('tr-TR')} ${tarih.toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit'})}`;
      return `
      <div class="new-free-item" onclick="modalAc('${f.id}')">
        <div class="nf-icon">🎉</div>
        <img src="${img}" style="width:64px;height:36px;object-fit:cover;border-radius:4px;flex-shrink:0" onerror="this.style.display='none'" loading="lazy">
        <div class="nf-info">
          <div class="nf-title">${f.ad}</div>
          <div class="nf-meta">
            <span>💰 Eskiden: <strong>$${f.oncekiFiyat.toFixed(2)}</strong></span>
            <span>💵 Normal: <strong>$${(f.oncekiNormal||0).toFixed(2)}</strong></span>
            <span class="nf-badge">%100 TASARRUF</span>
          </div>
        </div>
        <span class="nf-date">${tarihStr}</span>
        <a href="${url}" target="_blank" class="nf-action" onclick="event.stopPropagation()">Steam'de Aç</a>
      </div>`;
    }).filter(Boolean).join('');
  } else {
    document.getElementById('yeni-ucretsiz-list').innerHTML = `<div style="text-align:center;padding:24px;color:var(--muted);font-size:12px;border:1px dashed var(--border);border-radius:10px">
      ⏳ Henüz yeni ücretsiz oyun bulunamadı. Sistem fiyatları takip ediyor...
    </div>`;
  }

  // Tüm ücretsiz grid
  if(ucretsizOyunlar.length>0){
    document.getElementById('tum-ucretsiz-grid').innerHTML = ucretsizOyunlar.map((o,i)=>oyunKarti(o,i)).join('');
  } else {
    document.getElementById('tum-ucretsiz-grid').innerHTML = `<div class="empty">Henüz ücretsiz oyun bulunamadı</div>`;
  }
}

