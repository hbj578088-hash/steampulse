<script>
// ========== ORTAK ==========
const LS_FAVS = 'steam-favs';
const LS_PRICES = 'steam-price-history';
const LS_NEWFREE = 'steam-newfree';

let favoriler = JSON.parse(localStorage.getItem(LS_FAVS) || '[]');
let fiyatGecmisi = JSON.parse(localStorage.getItem(LS_PRICES) || '{}');
let yeniUcretsizler = JSON.parse(localStorage.getItem(LS_NEWFREE) || '[]');

function isFav(id){ return favoriler.includes(String(id)) }

function toggleFav(id, ad, e){
  e && e.stopPropagation && e.stopPropagation();
  e && e.preventDefault && e.preventDefault();
  id = String(id);
  if(isFav(id)){
    favoriler = favoriler.filter(f=>f!==id);
    toast(`${ad.slice(0,28)} favorilerden çıkarıldı`,'✕');
  } else {
    favoriler.push(id);
    toast(`${ad.slice(0,28)} favorilere eklendi`,'⭐');
  }
  localStorage.setItem(LS_FAVS, JSON.stringify(favoriler));
  updateFavUI();
  render();
  renderPop();
}

function toast(msg, ikon='✓'){
  const t = document.getElementById('toast');
  t.innerHTML = `<span>${ikon}</span> ${msg}`;
  t.classList.add('show');
  clearTimeout(t._t);
  t._t = setTimeout(()=>t.classList.remove('show'), 2800);
}

function sayfaDegis(sayfa, el){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById('page-'+sayfa).classList.add('active');
  el.classList.add('active');
  if(sayfa==='populer'){
    if(!popYuklendi) yuklePopuler();
    else { renderPop(); updatePopStats(); }
  }
  if(sayfa==='ucretsiz') renderUcretsizSayfasi();
}

// Scroll to top button
window.addEventListener('scroll',()=>{
  document.getElementById('scroll-top').classList.toggle('show',window.scrollY>400);
});

// ========== FİYAT TAKİP SİSTEMİ ==========
function kaydetYeniUcretsiz(oyun, oncekiFiyat, oncekiNormal, kaynak='takip'){
  const id = String(oyun.steamAppID);
  if(!id || yeniUcretsizler.some(f=>String(f.id)===id)) return false;
  const simdi = Date.now();
  const ad = oyun.title || 'Bilinmeyen oyun';
  yeniUcretsizler.unshift({
    id, ad,
    oncekiFiyat: Number(oncekiFiyat||0),
    oncekiNormal: Number(oncekiNormal||oncekiFiyat||0),
    kesifTarihi: simdi,
    steamAppID: oyun.steamAppID,
    kaynak
  });
  localStorage.setItem(LS_NEWFREE, JSON.stringify(yeniUcretsizler));
  updateFreeBadge();

  const banner = document.getElementById('alert-banner');
  if(banner){
    document.getElementById('alert-text').innerHTML = `<strong>🎉 ${ad}</strong> artık ücretsiz! Normal fiyatı $${Number(oncekiNormal||oncekiFiyat||0).toFixed(2)}.`;
    banner.classList.add('show');
    setTimeout(()=>banner.classList.remove('show'), 8000);
  }
  toast(`🔥 ${ad} artık ÜCRETSİZ!`,'🎉');
  return true;
}

function fiyatTakipEt(oyun){
  const id = String(oyun.steamAppID||'');
  if(!id) return false;
  const simdi = Date.now();
  const fiyat = Number(parseFloat(oyun.salePrice||0));
  const normal = Number(parseFloat(oyun.normalPrice||0));
  const onceki = fiyatGecmisi[id];
  let yeniBulundu = false;

  // ÖNEMLİ DÜZELTME:
  // Eski kod sadece localStorage'da daha önce paralı kayıt varsa algılıyordu.
  // İlk açılışta oyun zaten $0 gelirse kaçırıyordu. CheapShark normalPrice > 0
  // gönderiyorsa bu oyun "paralıydı, şimdi ücretsiz" kabul edilir.
  if(fiyat === 0 && normal > 0.01){
    yeniBulundu = kaydetYeniUcretsiz(oyun, normal, normal, 'api-normalPrice');
  }

  if(!onceki){
    fiyatGecmisi[id] = {
      sonFiyat: fiyat,
      sonNormal: normal,
      ilkGorulme: simdi,
      sonGuncelleme: simdi,
      gecmis: [{t:simdi, f:fiyat, n:normal}]
    };
    return yeniBulundu;
  }

  const oncekiFiyat = Number(onceki.sonFiyat||0);
  const oncekiNormal = Number(onceki.sonNormal||normal||0);

  onceki.gecmis = onceki.gecmis || [];
  // Aynı fiyatı çok kısa sürede tekrar tekrar yazma; geçmiş şişmesin.
  const son = onceki.gecmis[onceki.gecmis.length-1];
  if(!son || son.f !== fiyat || son.n !== normal){
    onceki.gecmis.push({t:simdi, f:fiyat, n:normal});
    if(onceki.gecmis.length>30) onceki.gecmis.shift();
  }

  onceki.sonFiyat = fiyat;
  onceki.sonNormal = normal;
  onceki.sonGuncelleme = simdi;

  if(oncekiFiyat > 0 && fiyat === 0){
    yeniBulundu = kaydetYeniUcretsiz(oyun, oncekiFiyat, oncekiNormal || normal, 'local-price-history') || yeniBulundu;
  }
  return yeniBulundu;
}
function fiyatGecmisiAl(id){
  const kayit = fiyatGecmisi[String(id)];
  if(!kayit) return [];
  return kayit.gecmis || [];
}

// ========== SAYFA 1: İNDİRİMLER ==========
let tumOyunlar = [];
let aktifFilter = 'hepsi';
let sadeceFav = false;

function updateFavUI(){
  document.getElementById('st-fav').textContent = favoriler.length;
  // Tüm fav butonlarını güncelle
  document.querySelectorAll('.fav-btn, .feat-fav, .rank-fav').forEach(btn=>{
    if(!btn.dataset.id) return;
    const id = btn.dataset.id;
    btn.textContent = isFav(id) ? '⭐' : '☆';
    if(btn.classList.contains('fav-btn')||btn.classList.contains('feat-fav'))
      btn.classList.toggle('active', isFav(id));
  });
}

function toggleFavFilter(){
  sadeceFav = !sadeceFav;
  document.getElementById('fav-btn').classList.toggle('fav-on', sadeceFav);
  render();
}

function updateFreeBadge(){
  const badge = document.getElementById('free-badge');
  const aktif = yeniUcretsizler.filter(f=>{
    const simdi = Date.now();
    return (simdi - f.kesifTarihi) < 7*86400000; // 7 gün
  });
  badge.textContent = aktif.length;
  if(aktif.length>0){
    badge.style.display='inline';
    badge.style.animation='popIn .4s ease';
    setTimeout(()=>badge.style.animation='',500);
  } else {
    badge.style.display='none';
  }
}

function oyunKarti(o, i, ekstra=''){
  const fav = isFav(o.steamAppID);
  const img = o.steamAppID ? `https://cdn.akamai.steamstatic.com/steam/apps/${o.steamAppID}/header.jpg` : '';
  const url = `https://store.steampowered.com/app/${o.steamAppID}`;
  const indirim = Math.round(parseFloat(o.savings||0));
  const ucret = parseFloat(o.salePrice)===0;
  const puan = o.dealRating ? parseFloat(o.dealRating).toFixed(1) : '—';
  const yeniUc = fiyatGecmisi[String(o.steamAppID)] && fiyatGecmisi[String(o.steamAppID)].sonFiyat===0 && fiyatGecmisi[String(o.steamAppID)].gecmis.length>1 && fiyatGecmisi[String(o.steamAppID)].gecmis[fiyatGecmisi[String(o.steamAppID)].gecmis.length-2].f>0;
  const cardClass = ucret ? 'free-highlight' : '';
  return `
  <div class="card ${cardClass}" style="animation-delay:${Math.min(i*0.035,0.7)}s" onclick="modalAc('${o.steamAppID}')">
    <div class="card-img-wrap">
      <img class="card-img" src="${img}" onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22460%22 height=%22215%22 fill=%22%23101830%22><rect width=%22460%22 height=%22215%22/><text x=%22230%22 y=%22115%22 text-anchor=%22middle%22 fill=%22%23243050%22 font-size=%2214%22>No Image</text></svg>'" loading="lazy">
      ${ucret ? `<div class="tag tag-free">🆓 ÜCRETSİZ</div>` : indirim>=50 ? `<div class="tag tag-discount">−${indirim}%</div>` : ''}
      ${yeniUc ? `<div class="tag tag-newfree">Yeni Ücretsiz</div>` : ''}
      <div class="fav-btn ${fav?'active':''}" data-id="${o.steamAppID}" onclick="toggleFav('${o.steamAppID}','${(o.title||'').replace(/'/g,"\\'")}',event)">${fav?'⭐':'☆'}</div>
    </div>
    <div class="card-body">
      <div class="card-title" title="${(o.title||'')}">${o.title||'?'} ${o.isSteamPromo?'<span class="badge badge-green">Steam</span>':''}</div>
      <div class="price-row">
        ${ucret
          ? `<span class="price" style="font-size:14px">ÜCRETSİZ</span><span class="original">$${parseFloat(o.normalPrice||0).toFixed(2)}</span>`
          : `<span class="price">$${parseFloat(o.salePrice||0).toFixed(2)}</span><span class="original">$${parseFloat(o.normalPrice||0).toFixed(2)}</span>`
        }
        ${!ucret&&indirim>0?`<span class="badge badge-red">−${indirim}%</span>`:''}
        ${ucret?`<span class="badge badge-green">Ücretsiz</span>`:''}
      </div>
      <div class="card-meta">
        <span class="rating-txt">⭐ ${puan}</span>
        <button class="go-btn" onclick="event.stopPropagation();modalAc('${o.steamAppID}')" style="cursor:pointer">Detay</button>
      </div>
    </div>
    ${ekstra}
  </div>`;
}

function render(){
  const q = document.getElementById('ara').value.toLowerCase().trim();
  const sortBy = document.getElementById('sirala').value;
  const maxF = parseInt(document.getElementById('max-fiyat').value);

  let liste = [...tumOyunlar];
  if(aktifFilter==='indirimli') liste = liste.filter(o=>parseFloat(o.salePrice||0)>0);
  if(aktifFilter==='ucretsiz') liste = liste.filter(o=>parseFloat(o.salePrice||0)===0);
  if(sadeceFav) liste = liste.filter(o=>isFav(o.steamAppID));
  if(q) liste = liste.filter(o=>(o.title||'').toLowerCase().includes(q));
  if(maxF<60) liste = liste.filter(o=>parseFloat(o.salePrice||0)<=maxF);

  liste.sort((a,b)=>{
    if(sortBy==='indirim') return parseFloat(b.savings||0)-parseFloat(a.savings||0);
    if(sortBy==='fiyat-asc') return parseFloat(a.salePrice||0)-parseFloat(b.salePrice||0);
    if(sortBy==='fiyat-desc') return parseFloat(b.salePrice||0)-parseFloat(a.salePrice||0);
    if(sortBy==='puan') return parseFloat(b.dealRating||0)-parseFloat(a.dealRating||0);
    if(sortBy==='isim') return (a.title||'').localeCompare(b.title||'','tr');
    return 0;
  });

  const indirimli = liste.filter(o=>parseFloat(o.salePrice||0)>0);
  const ucretsiz  = liste.filter(o=>parseFloat(o.salePrice||0)===0);
  let html = '';

  if(aktifFilter!=='ucretsiz'&&indirimli.length>0){
    html+=`<div class="section">
      <div class="section-header">🔥 İndirimli Oyunlar <span class="sec-count">${indirimli.length}</span></div>
      <div class="grid">${indirimli.map((o,i)=>oyunKarti(o,i)).join('')}</div>
    </div>`;
  }
  if(aktifFilter!=='indirimli'&&ucretsiz.length>0){
    if(html) html+=`<div class="section-divider"></div>`;
    html+=`<div class="section">
      <div class="section-header">🎁 Ücretsiz Oyunlar <span class="sec-count">${ucretsiz.length}</span></div>
      <div class="grid">${ucretsiz.map((o,i)=>oyunKarti(o,i)).join('')}</div>
    </div>`;
  }
  if(!html){
    html=`<div class="section"><div class="grid"><div class="empty">${q?`"${q}" için sonuç bulunamadı 🔍`:'Kriterlere uyan oyun yok'}</div></div></div>`;
  }
  document.getElementById('main-content').innerHTML=html;
