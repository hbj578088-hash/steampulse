const TL_FALLBACK = 32.50;
let usdTryRate = parseFloat(localStorage.getItem('steampulse-usdtry') || '0') || TL_FALLBACK;
let usdTryRateTime = parseInt(localStorage.getItem('steampulse-usdtry-time') || '0', 10) || 0;
let steamDetailsCache = JSON.parse(localStorage.getItem('steampulse-steam-details') || '{}');
let priceAlerts = JSON.parse(localStorage.getItem('steampulse-price-alerts') || '{}');

function moneyUSD(v){
  v = parseFloat(v || 0);
  return v === 0 ? 'Ücretsiz' : '$' + v.toFixed(2);
}
function moneyTRY(v){
  v = parseFloat(v || 0);
  return v === 0 ? '₺0 / Ücretsiz' : '₺' + (v * usdTryRate).toLocaleString('tr-TR',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function temizHTML(html){
  const div = document.createElement('div');
  div.innerHTML = html || '';
  return (div.textContent || div.innerText || '').replace(/\s+/g,' ').trim();
}
function kisalt(txt, n=420){
  txt = (txt || '').trim();
  return txt.length > n ? txt.slice(0,n).trim() + '…' : txt;
}
async function kurGuncelle(){
  const gun = 12 * 60 * 60 * 1000;
  if(Date.now() - usdTryRateTime < gun) return usdTryRate;
  try{
    const r = await fetch('https://open.er-api.com/v6/latest/USD');
    const j = await r.json();
    if(j && j.rates && j.rates.TRY){
      usdTryRate = parseFloat(j.rates.TRY);
      usdTryRateTime = Date.now();
      localStorage.setItem('steampulse-usdtry', String(usdTryRate));
      localStorage.setItem('steampulse-usdtry-time', String(usdTryRateTime));
    }
  }catch(e){}
  return usdTryRate;
}
async function steamDetayAl(appid){
  appid = String(appid);
  const cache = steamDetailsCache[appid];
  if(cache && Date.now() - cache.t < 24*60*60*1000) return cache.data;
  try{
    const r = await fetch(`https://store.steampowered.com/api/appdetails?appids=${appid}&cc=tr&l=turkish`);
    const j = await r.json();
    const data = j && j[appid] && j[appid].success ? j[appid].data : null;
    if(data){
      steamDetailsCache[appid] = {t:Date.now(), data};
      localStorage.setItem('steampulse-steam-details', JSON.stringify(steamDetailsCache));
    }
    return data;
  }catch(e){ return null; }
}
function steamWebUrl(id){ return `https://store.steampowered.com/app/${id}`; }
function steamAppUrl(id){ return `steam://openurl/${steamWebUrl(id)}`; }
function steamdeAc(id){
  const web = steamWebUrl(id);
  try{ window.location.href = steamAppUrl(id); }catch(e){}
  setTimeout(()=>{ window.open(web, '_blank'); }, 850);
