function fiyatAlarmiKur(id, ad, fiyat){
  id = String(id); fiyat = parseFloat(fiyat||0);
  const hedef = fiyat > 0 ? Math.max(0.99, Math.floor(fiyat*0.8)) : 0;
  const giris = prompt(`${ad} için hedef fiyatı USD olarak yaz:`, hedef.toFixed(2));
  if(giris===null) return;
  const val = parseFloat(String(giris).replace(',', '.'));
  if(isNaN(val) || val < 0){ toast('Geçerli bir fiyat girmen lazım','⚠️'); return; }
  priceAlerts[id] = {title:ad, target:val, created:Date.now()};
  localStorage.setItem('steampulse-price-alerts', JSON.stringify(priceAlerts));
  toast(`Fiyat alarmı kuruldu: $${val.toFixed(2)}`,'🔔');
}
function fiyatAlarmlariniKontrolEt(){
  const alarms = JSON.parse(localStorage.getItem('steampulse-price-alerts') || '{}');
  tumOyunlar.forEach(o=>{
    const a = alarms[String(o.steamAppID)];
    if(a && parseFloat(o.salePrice||0) <= parseFloat(a.target)){
      toast(`${o.title} hedef fiyatına düştü: ${moneyUSD(o.salePrice)}`,'🔔');
    }
  });
}

